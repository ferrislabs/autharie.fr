---
import Base from '../layouts/base.astro'
import { SiteHeader } from '../components/site-header'
import { PricingExperience } from '../components/pricing-experience'
import SiteFooter from '../components/site-footer.astro'
import { pricingCopy } from '../pricing/copy'
import type { Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const docsUrl = import.meta.env.PUBLIC_DOCS_URL || ''
const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'https://console.autharie.fr'
const hero = pricingCopy[locale].hero

const meta = {
  en: {
    title: 'Pricing: managed or BYOC, FerrisKey or Keycloak | Autharie',
    description: 'Fully managed or in your own cloud, FerrisKey or Keycloak. Prices update as you choose, with a comparison against running it yourself.',
  },
  fr: {
    title: 'Tarifs : managé ou BYOC, FerrisKey ou Keycloak | Autharie',
    description: 'Entièrement managé ou dans votre cloud, FerrisKey ou Keycloak. Les prix se recalculent en direct, avec un comparatif face à une gestion en interne.',
  },
}
---

<Base title={meta[locale].title} description={meta[locale].description}>
  <SiteHeader docsUrl={docsUrl} consoleUrl={consoleUrl} locale={locale} pathname={Astro.url.pathname} client:load transition:persist={`site-header-${locale}`} />

  <main>
    <section class="relative overflow-hidden pb-10 pt-14 sm:pt-20">
      <div class="bg-grid pointer-events-none absolute inset-0 -z-10 h-[420px]" aria-hidden="true"></div>
      <div class="mx-auto max-w-4xl px-5 text-center">
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 class="mt-5 text-balance text-4xl leading-[1.05] sm:text-[3.4rem] sm:leading-[1.04]">
          <span class="block">{hero.h1a}</span>
          <span class="block text-primary">{hero.h1b}</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">{hero.lead}</p>
      </div>
    </section>

    <section class="pb-20 pt-8 sm:pb-28">
      <div class="mx-auto max-w-6xl px-5">
        <PricingExperience client:load locale={locale} />
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</Base>
