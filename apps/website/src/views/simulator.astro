---
import Base from '../layouts/base.astro'
import { SiteHeader } from '../components/site-header'
import Icon from '../components/icon.astro'
import { CostSimulator } from '../components/cost-simulator'
import CtaSection from '../components/cta-section.astro'
import SiteFooter from '../components/site-footer.astro'
import { localePath, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const docsUrl = import.meta.env.PUBLIC_DOCS_URL || ''
const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'https://console.autharie.fr'

const copy = {
  en: {
    title: 'What does it really cost to run your own IAM? · Autharie',
    description:
      'Estimate the infrastructure, engineering time and on-call it takes to run an identity provider yourself.',
    eyebrow: 'Simulator',
    h1a: 'What does it really cost to run',
    h1b: 'your own identity provider?',
    lead: 'The licence is free. The servers, the upgrades, the backups nobody tests and the night someone gets woken up are not. Put your own numbers in.',
    talk: 'Talk to us about taking this off your plate',
  },
  fr: {
    title: 'Que coûte vraiment l’exploitation de votre propre IAM ? · Autharie',
    description:
      'Estimez l’infrastructure, le temps d’ingénierie et l’astreinte qu’il faut pour exploiter soi-même un fournisseur d’identité.',
    eyebrow: 'Simulateur',
    h1a: 'Que coûte vraiment l’exploitation',
    h1b: 'de votre propre fournisseur d’identité ?',
    lead: 'La licence est gratuite. Les serveurs, les mises à jour, les sauvegardes que personne ne teste et la nuit où quelqu’un est réveillé, non. Mettez vos propres chiffres.',
    talk: 'Parlons de ce que nous pouvons vous retirer des mains',
  },
}
const t = copy[locale]
---

<Base title={t.title} description={t.description}>
  <SiteHeader docsUrl={docsUrl} consoleUrl={consoleUrl} locale={locale} pathname={Astro.url.pathname} client:load transition:persist={`site-header-${locale}`} />

  <main>
    <section class="relative overflow-hidden pb-10 pt-14 sm:pt-20">
      <div class="bg-grid pointer-events-none absolute inset-0 -z-10 h-[420px]" aria-hidden="true"></div>
      <div class="mx-auto max-w-4xl px-5 text-center">
        <p class="eyebrow">{t.eyebrow}</p>
        <h1 class="mt-5 text-balance text-4xl leading-[1.05] sm:text-[3.4rem] sm:leading-[1.04]">
          <span class="block">{t.h1a}</span>
          <span class="block text-primary">{t.h1b}</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">{t.lead}</p>
      </div>
    </section>

    <section class="pb-20 sm:pb-28">
      <div class="mx-auto max-w-6xl px-5">
        <CostSimulator client:load locale={locale} />
        <p class="mt-8 text-center">
          <a
            href={localePath(locale, '/contact')}
            class="inline-flex items-center gap-2 text-sm font-medium text-primary"
          >
            {t.talk}
            <Icon name="arrow" class="size-4" />
          </a>
        </p>
      </div>
    </section>

    <CtaSection locale={locale} />
  </main>

  <SiteFooter locale={locale} />
</Base>
