---
import { type Locale } from '../i18n'
import Base from '../layouts/base.astro'
import { SiteHeader } from '../components/site-header'
import HeroSection from '../components/hero-section.astro'
import ProblemSection from '../components/problem-section.astro'
import SolutionsSection from '../components/solutions-section.astro'
import AgentPolicySection from '../components/agent-policy-section.astro'
import AudienceSection from '../components/audience-section.astro'
import HowSection from '../components/how-section.astro'
import PlansSection from '../components/plans-section.astro'
import VisionSection from '../components/vision-section.astro'
import EuropeSection from '../components/europe-section.astro'
import FaqSection from '../components/faq-section.astro'
import CtaSection from '../components/cta-section.astro'
import SiteFooter from '../components/site-footer.astro'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const docsUrl = import.meta.env.PUBLIC_DOCS_URL || ''
const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'https://console.autharie.fr'
const title = {
  en: 'Autharie: identity for your users, services and AI agents',
  fr: 'Autharie : l’identité de vos utilisateurs, services et agents IA',
}

const description = {
  en: 'A complete IAM built on Ferriskey: secure sign in, SSO and passkeys for your users, service accounts for your apps, limited rights and a stop button for your AI agents. Hosted in Europe.',
  fr: 'Un IAM complet construit sur Ferriskey : connexion sécurisée, SSO et passkeys pour vos utilisateurs, comptes de service pour vos applications, droits limités et bouton stop pour vos agents IA. Hébergé en Europe.',
}
---

<Base
  title={title[locale]}
  description={description[locale]}
>
  <SiteHeader docsUrl={docsUrl} consoleUrl={consoleUrl} locale={locale} pathname={Astro.url.pathname} client:load transition:persist={`site-header-${locale}`} />

  <main id="main" tabindex="-1">
    <HeroSection locale={locale} />
    <ProblemSection locale={locale} />
    <SolutionsSection locale={locale} />
    <AgentPolicySection locale={locale} />
    <AudienceSection locale={locale} />
    <HowSection locale={locale} />
    <VisionSection locale={locale} />
    <PlansSection locale={locale} />
    <EuropeSection locale={locale} />
    <FaqSection locale={locale} />
    <CtaSection locale={locale} />
  </main>

  <SiteFooter locale={locale} />
</Base>
