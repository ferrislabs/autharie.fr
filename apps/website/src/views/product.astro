---
import Base from '../layouts/base.astro'
import { SiteHeader } from '../components/site-header'
import ProductPage from '../components/product-page.astro'
import CtaSection from '../components/cta-section.astro'
import SiteFooter from '../components/site-footer.astro'
import { getProduct } from '../data/products'
import type { Locale } from '../i18n'
import { describe } from '../seo/describe'

interface Props {
  slug: string
  locale?: Locale
}

const { slug, locale = 'en' } = Astro.props
const product = getProduct(slug, locale)!
const suffix = { en: 'Managed IAM', fr: 'IAM managé' }
const docsUrl = import.meta.env.PUBLIC_DOCS_URL || ''
const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'https://console.autharie.fr'
---

<Base title={`${product.name} · ${suffix[locale]} | Autharie`} description={describe(product.hero.lead)}>
  <SiteHeader docsUrl={docsUrl} consoleUrl={consoleUrl} locale={locale} pathname={Astro.url.pathname} client:load transition:persist={`site-header-${locale}`} />
  <main>
    <ProductPage product={product} locale={locale} />
    <CtaSection locale={locale} />
  </main>
  <SiteFooter locale={locale} />
</Base>
