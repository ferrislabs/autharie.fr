---
import Base from '../layouts/base.astro'
import { SiteHeader } from '../components/site-header'
import Icon from '../components/icon.astro'
import { ContactForm } from '../components/contact-form'
import SiteFooter from '../components/site-footer.astro'
import { localePath, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const docsUrl = import.meta.env.PUBLIC_DOCS_URL || ''
const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'https://console.autharie.fr'
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || ''

const copy = {
  en: {
    title: 'Talk to us | Autharie',
    description: 'Tell us what you run and what you want to change. We come back to you with a proposal.',
    h1a: 'Tell us what you run,',
    h1b: 'we will take it from there.',
    lead: 'The beta, a migration, a question about security. A few lines are enough to start.',
    points: [
      'You write to the team that builds Autharie and Ferriskey.',
      'We answer with a proposal, not a sales sequence.',
      'Your details are used to answer you and for nothing else.',
    ],
    direct: 'Prefer email?',
  },
  fr: {
    title: 'Nous contacter | Autharie',
    description: 'Dites-nous ce que vous faites tourner et ce que vous voulez changer. Nous revenons vers vous avec une proposition.',
    h1a: 'Dites-nous ce que vous faites tourner,',
    h1b: 'nous nous occupons du reste.',
    lead: 'La bêta, une migration, une question de sécurité. Quelques lignes suffisent pour commencer.',
    points: [
      'Vous écrivez à l’équipe qui construit Autharie et Ferriskey.',
      'Nous répondons par une proposition, pas par une séquence commerciale.',
      'Vos informations servent à vous répondre, et à rien d’autre.',
    ],
    direct: 'Vous préférez l’e-mail ?',
  },
}
const t = copy[locale]
---

<Base title={t.title} description={t.description}>
  <SiteHeader docsUrl={docsUrl} consoleUrl={consoleUrl} locale={locale} pathname={Astro.url.pathname} client:load transition:persist={`site-header-${locale}`} />

  <main id="main" tabindex="-1">
    <section class="relative overflow-hidden pb-20 pt-14 sm:pb-28 sm:pt-20">
      <div class="bg-grid pointer-events-none absolute inset-0 -z-10 h-[460px]" aria-hidden="true"></div>
      <div class="mx-auto grid max-w-6xl items-start gap-12 px-5 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <div>
          <h1 class="text-balance text-3xl leading-[1.1] sm:text-[2.6rem]">
            <span class="block">{t.h1a}</span>
            <span class="block text-primary">{t.h1b}</span>
          </h1>
          <p class="mt-6 max-w-lg text-lg text-muted-foreground">{t.lead}</p>

          <ul class="mt-8 space-y-3">
            {
              t.points.map((point) => (
                <li class="flex items-start gap-3">
                  <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                    <Icon name="check" class="size-3.5" />
                  </span>
                  <span class="text-sm leading-relaxed">{point}</span>
                </li>
              ))
            }
          </ul>

          <p class="mt-8 text-sm text-muted-foreground">
            {t.direct}
            <a href="mailto:contact@ferrislabs.fr" class="font-medium text-primary hover:underline">contact@ferrislabs.fr</a>
          </p>
        </div>

        <ContactForm client:load locale={locale} endpoint={endpoint} />
      </div>
    </section>
  </main>

  <SiteFooter locale={locale} />
</Base>
