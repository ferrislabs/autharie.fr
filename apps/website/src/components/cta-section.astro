---
import { primaryCta } from '../platform'
import Icon from './icon.astro'
import { localePath, type Locale } from '../i18n'

const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'https://console.autharie.fr'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    title: 'Put your first agent under control',
    body: 'Tell us which agents you run. We open your space, and you write your first rule in a few minutes.',
    next: 'We read every request ourselves and open spaces in small groups during the private beta.',
    talk: 'Talk to the founders',
  },
  fr: {
    title: 'Mettez votre premier agent sous contrôle',
    body: "Dites-nous quels agents vous faites travailler. Nous ouvrons votre espace, et vous écrivez votre première règle en quelques minutes.",
    next: 'Nous lisons chaque demande nous-mêmes et ouvrons les espaces par petits groupes pendant la bêta privée.',
    talk: 'Parler aux fondateurs',
  },
}
const t = copy[locale]
const cta = primaryCta(locale, consoleUrl)
---

<section class="bg-deep text-white">
  <div class="mx-auto max-w-6xl px-5 py-20 text-center sm:py-28">
    <h2 class="mx-auto max-w-2xl text-3xl text-white sm:text-[2.6rem] sm:leading-[1.1]">
      {t.title}
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-lg text-white/70">
      {t.body}
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      <a
        href={cta.href}
        class="inline-flex h-11 items-center gap-2 rounded-md bg-white px-6 text-sm font-medium text-ink transition-opacity hover:opacity-90"
      >
        <span>{cta.label}</span>
        <Icon name="arrow" class="size-4" />
      </a>
      <a
        href={localePath(locale, '/contact')}
        class="inline-flex h-11 items-center gap-2 rounded-md border border-white/25 px-6 text-sm font-medium text-white transition-colors hover:bg-white/10"
      >
        <span>{t.talk}</span>
      </a>
    </div>
    <p class="mx-auto mt-6 max-w-md text-sm text-white/70">{t.next}</p>
  </div>
</section>
