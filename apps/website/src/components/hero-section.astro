---
import { AgentControl } from './agent-control'
import Icon from './icon.astro'
import type { Locale } from '../i18n'
import { primaryCta } from '../platform'

const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'https://console.autharie.fr'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    badge: 'Private beta · limited spots · free to start',
    title1: 'Your AI agents do the work.',
    title2: 'You stay in control.',
    body: 'Autharie gives each AI agent its access, shows you everything it does and stops it at the first slip. And sign in for your users is ready in two minutes, so you launch faster, safely.',
    how: 'See how it works',
    note: 'Ready in 2 minutes · No credit card · Made in France',
  },
  fr: {
    badge: 'Bêta privée · places limitées · gratuit pour démarrer',
    title1: 'Vos agents IA travaillent.',
    title2: 'Vous gardez la main.',
    body: "Autharie donne à chaque agent IA ses accès, vous montre tout ce qu'il fait et l'arrête au moindre écart. Et la connexion de vos utilisateurs est prête en deux minutes : vous lancez plus vite, en sécurité.",
    how: 'Voir comment ça marche',
    note: 'Prêt en 2 minutes · Sans carte bancaire · Conçu en France',
  },
}
const t = copy[locale]
const cta = primaryCta(locale, consoleUrl)
---

<section class="relative overflow-hidden pb-16 pt-14 sm:pb-24 sm:pt-20">
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10 h-[620px]" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-primary/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-4xl text-center">
      <a
        href={cta.href}
        class="inline-flex items-center gap-2 rounded-full border bg-card px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:text-foreground"
      >
        <span class="live-dot size-1.5 rounded-full bg-primary"></span>
        <span>{t.badge}</span>
        <Icon name="arrow" class="size-3.5" />
      </a>

      <h1 class="mt-6 text-balance text-4xl leading-[1.05] sm:text-[4rem] sm:leading-[1.04]">
        <span class="block">{t.title1}</span>
        <span class="block text-primary">{t.title2}</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
        {t.body}
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={cta.href}
          class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          <span>{cta.label}</span>
          <Icon name="arrow" class="size-4" />
        </a>
        <a
          href="#how"
          class="inline-flex h-11 items-center gap-2 rounded-md border bg-card px-6 text-sm font-medium transition-colors hover:bg-accent"
        >
          <span>{t.how}</span>
        </a>
      </div>

      <p class="mt-5 flex items-center justify-center gap-2 text-xs font-medium text-muted-foreground">
        <span class="inline-flex h-3 w-[18px] overflow-hidden rounded-[2px] ring-1 ring-black/10" aria-hidden="true">
          <i class="w-1/3 bg-[#0055A4]"></i>
          <i class="w-1/3 bg-white"></i>
          <i class="w-1/3 bg-[#EF4135]"></i>
        </span>
        {t.note}
      </p>
    </div>

    <div class="mx-auto mt-14 max-w-5xl sm:mt-20">
      <AgentControl client:visible locale={locale} />
    </div>
  </div>
</section>
