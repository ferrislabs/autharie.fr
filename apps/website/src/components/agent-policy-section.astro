---
import { AgentPolicy } from './agent-policy'
import type { Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    eyebrow: 'Agent policies',
    title: 'Rules for agents, as blocks or as code',
    lead: 'Identity, scope, network, tool: a policy combines conditions and is evaluated on every call. Your team edits it visually or keeps it as code in a repository, with every decision traced end to end.',
  },
  fr: {
    eyebrow: 'Règles pour agents',
    title: 'Des règles pour agents, en blocs ou en code',
    lead: 'Identité, scope, réseau, outil : une règle combine des conditions et s’évalue à chaque appel. Votre équipe l’édite en visuel ou la garde en code dans un dépôt, et chaque décision est tracée de bout en bout.',
  },
}
const t = copy[locale]
---

<section id="policies" class="scroll-mt-20 border-y bg-surface/50">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <div class="max-w-2xl">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="mt-4 text-3xl sm:text-[2.6rem] sm:leading-[1.1]">{t.title}</h2>
      <p class="mt-5 text-lg text-muted-foreground">{t.lead}</p>
    </div>
    <div class="mt-12">
      <AgentPolicy client:visible locale={locale} />
    </div>
  </div>
</section>
