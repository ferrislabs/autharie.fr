---
import Icon from './icon.astro'
import { localePath, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    title: 'Handing work to agents should not mean losing control.',
    beliefs: [
      'Software no longer waits for a click. Agents read, write and act on behalf of your teams.',
      'Every agent deserves its own identity, rights limited to its task, and a record of everything it does.',
      'When one runs away, anyone on the team should be able to stop it in one click, without being a security expert.',
      'And all of it should stay yours: an open source engine, hosted in Europe, that you can leave whenever you want.',
    ],
    signoff: 'That is why we are building Autharie, on top of Ferriskey.',
    cta: 'See the technology',
  },
  fr: {
    title: 'Confier du travail à des agents ne devrait pas vouloir dire perdre la main.',
    beliefs: [
      'Les logiciels n’attendent plus qu’on clique. Des agents lisent, écrivent et agissent au nom de vos équipes.',
      'Chaque agent mérite sa propre identité, des droits limités à sa tâche, et une trace de tout ce qu’il fait.',
      'Quand l’un d’eux s’emballe, n’importe qui dans l’équipe doit pouvoir l’arrêter en un clic, sans être expert en sécurité.',
      'Et tout cela doit rester à vous : un moteur open source, hébergé en Europe, que vous pouvez quitter quand vous voulez.',
    ],
    signoff: 'C’est pour ça que nous construisons Autharie, au-dessus de Ferriskey.',
    cta: 'Voir la technologie',
  },
}
const t = copy[locale]
---

<section id="vision" class="scroll-mt-20 border-y bg-surface/50">
  <div class="mx-auto max-w-3xl px-5 py-20 sm:py-28">
    <h2 class="text-balance text-3xl sm:text-[2.6rem] sm:leading-[1.1]">{t.title}</h2>

    <ul class="mt-12 space-y-7">
      {
        t.beliefs.map((belief) => (
          <li class="border-l-2 border-primary/30 pl-5">
            <p class="text-lg leading-relaxed sm:text-xl">{belief}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 border-t pt-8">
      <p class="text-xl font-semibold text-primary sm:text-2xl">{t.signoff}</p>
      <a
        href={localePath(locale, '/technology')}
        class="mt-4 inline-flex items-center gap-2 py-1 text-sm font-medium text-primary"
      >
        {t.cta}
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</section>
