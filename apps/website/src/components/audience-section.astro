---
import Icon from './icon.astro'
import { localePath, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    eyebrow: 'Who it is for',
    title: 'From the first project to the growing company',
    people: [
      {
        icon: 'rocket',
        who: 'You are launching a project',
        title: 'Look like a grown-up product from day one',
        description: 'Sign in, accounts and security are ready while you focus on your first customers. Your agents can help without risking a costly mistake.',
      },
      {
        icon: 'zap',
        who: 'Founders who build with AI',
        title: 'Build fast with AI, without leaving the door open',
        description: 'Your product and your agents are built fast with AI. Autharie gives every agent limited access and shows you what it did, even if nobody on the team is a security expert.',
      },
      {
        icon: 'users',
        who: 'A growing company',
        title: 'Bring AI into your teams, safely',
        description: 'Speed up with agents while keeping control: who may do what, a complete record of every action, and data that stays in Europe.',
      },
    ],
    platform: {
      who: 'You are building your own AI platform',
      title: 'Identity and rules for your in-house agents',
      description:
        'Your internal AI platform needs to know who each user and each agent is, and what they are allowed to do. Autharie and Ferriskey provide that layer, so your team builds the platform, not the plumbing.',
      cta: 'Talk to us about your platform',
    },
  },
  fr: {
    eyebrow: 'Pour qui',
    title: 'Du premier projet à l’entreprise qui accélère',
    people: [
      {
        icon: 'rocket',
        who: 'Vous lancez un projet',
        title: 'Ayez l’air d’un vrai produit dès le premier jour',
        description: 'Connexion, comptes et sécurité sont prêts pendant que vous allez chercher vos premiers clients. Vos agents vous aident, sans risquer la boulette qui coûte cher.',
      },
      {
        icon: 'zap',
        who: 'Des fondateurs qui construisent avec l’IA',
        title: 'Construisez vite avec l’IA, sans laisser la porte ouverte',
        description: 'Votre produit et vos agents se construisent vite, avec l’IA. Autharie donne à chaque agent des accès limités et vous montre ce qu’il a fait, même sans expert sécurité dans l’équipe.',
      },
      {
        icon: 'users',
        who: 'Une PME qui accélère',
        title: 'Faites entrer l’IA dans vos équipes, en sécurité',
        description: 'Accélérez avec des agents en gardant le contrôle : qui peut faire quoi, une trace complète de chaque action, et des données qui restent en Europe.',
      },
    ],
    platform: {
      who: 'Vous construisez votre propre plateforme IA',
      title: 'L’identité et les règles de vos agents maison',
      description:
        'Votre plateforme IA interne doit savoir qui est chaque utilisateur et chaque agent, et ce qu’il a le droit de faire. Autharie et Ferriskey apportent cette brique, pour que votre équipe construise la plateforme, pas la plomberie.',
      cta: 'Parler de votre plateforme',
    },
  },
}
const t = copy[locale]
---

<section id="for-who" class="scroll-mt-20">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="mt-4 text-balance text-3xl sm:text-[2.6rem] sm:leading-[1.1]">{t.title}</h2>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-3">
      {
        t.people.map((p) => (
          <div class="flex flex-col rounded-2xl border bg-card p-7">
            <span class="flex items-center gap-2 text-sm font-medium text-primary">
              <Icon name={p.icon} class="size-4" />
              {p.who}
            </span>
            <h3 class="mt-4 text-lg font-semibold">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{p.description}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-5 flex flex-col gap-6 rounded-2xl bg-deep p-8 text-white lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <span class="flex items-center gap-2 text-sm font-medium text-primary-soft">
          <Icon name="cpu" class="size-4" />
          {t.platform.who}
        </span>
        <h3 class="mt-3 text-xl font-semibold text-white">{t.platform.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-white/70">{t.platform.description}</p>
      </div>
      <a
        href={`${localePath(locale, '/contact')}?topic=other`}
        class="inline-flex h-11 shrink-0 items-center gap-2 self-start rounded-md bg-white px-5 text-sm font-medium text-ink transition-opacity hover:opacity-90 lg:self-center"
      >
        {t.platform.cta}
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
  </div>
</section>
