---
import { Code } from 'astro:components'
import { localePath, type Locale } from '../i18n'
import Icon from './icon.astro'

const manifest = `apiVersion: autharie.fr/v1alpha
kind: IdentityInstance
metadata:
  name: acme-production
spec:
  provider: ferriskey
  version: "1.4.2"
  hostname: id.acme.com
  allowedCidrs:
    - 203.0.113.0/24
  database:
    mode: managedCluster
    managedCluster:
      instances: 3
      storage:
        size: 50Gi
  backup:
    destinationPath: s3://acme-identity-archives
    encryption: "kms:acme-identity"
  ingress:
    enabled: true
    tls:
      enabled: true
      clusterIssuer: letsencrypt`

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    facts: [
      {
        icon: 'rotate',
        title: 'Reconciled, not deployed once',
        description:
          'An operator compares what the cluster has against what the resource asks for, continuously. Delete a pod and it comes back.',
      },
      {
        icon: 'terminal',
        title: 'Console, API or manifest',
        description:
          'The console has no private door. Everything it does goes through the same documented API, and the client is generated from it.',
      },
      {
        icon: 'zap',
        title: 'Written in Rust',
        description:
          'The control plane, the operator and the data plane agent. Compile time checked SQL, and a binary that starts in milliseconds.',
      },
    ],
    eyebrow: 'Underneath',
    title: 'It is Kubernetes under there, and it shows',
    intro:
      'Every instance is a custom resource. If you already run clusters, nothing here is a surprise, and kubectl still works the way you expect.',
  },
  fr: {
    facts: [
      {
        icon: 'rotate',
        title: 'Réconcilié en continu, pas déployé une fois',
        description:
          'Un operator compare en permanence ce que le cluster contient avec ce que la ressource demande. Supprimez un pod et il revient.',
      },
      {
        icon: 'terminal',
        title: 'Console, API ou manifeste',
        description:
          'La console n\'a pas de porte dérobée. Tout ce qu\'elle fait passe par la même API documentée, et le client en est généré.',
      },
      {
        icon: 'zap',
        title: 'Écrit en Rust',
        description:
          'Le control plane, l\'operator et l\'agent du data plane. Du SQL vérifié à la compilation, et un binaire qui démarre en quelques millisecondes.',
      },
    ],
    eyebrow: 'Sous le capot',
    title: 'C\'est du Kubernetes là-dessous, et ça se voit',
    intro:
      'Chaque instance est une ressource personnalisée. Si vous exploitez déjà des clusters, rien ici ne vous surprendra, et kubectl fonctionne comme vous l\'attendez.',
  },
}

const t = copy[locale]
---

<section id="declarative" class="scroll-mt-20 border-y bg-surface/50">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="min-w-0 lg:col-span-2">
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 class="mt-4 text-3xl sm:text-[2.6rem] sm:leading-[1.1]">
          {t.title}
        </h2>
        <p class="mt-5 text-lg text-muted-foreground">
          {t.intro}
        </p>

        <div class="mt-10 space-y-7">
          {
            t.facts.map((fact) => (
              <div class="flex gap-4">
                <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border bg-card text-primary">
                  <Icon name={fact.icon} class="size-[18px]" />
                </span>
                <div>
                  <h3 class="font-semibold">
                    {fact.title}
                  </h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                    {fact.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="min-w-0 lg:col-span-3">
        <div class="overflow-hidden rounded-xl border bg-deep shadow-sm">
          <div class="flex items-center justify-between border-b border-white/10 px-4 py-2.5">
            <span class="font-mono text-[11px] text-white/50">identityinstance.yaml</span>
            <span class="rounded border border-white/15 px-1.5 py-px font-mono text-[10px] text-white/50"
              >autharie.fr/v1alpha</span
            >
          </div>
          <div class="code-surface overflow-x-auto p-5 text-[12.5px] leading-[1.7]">
            <Code code={manifest} lang="yaml" theme="poimandres" />
          </div>
        </div>

        <div class="mt-4 overflow-hidden rounded-xl border bg-deep">
          <pre class="overflow-x-auto px-5 py-4 font-mono text-[11.5px] leading-relaxed text-white/70"><code>$ kubectl get identityinstances
NAME              PROVIDER    VERSION   PHASE     READY   AGE
acme-production   ferriskey   1.4.2     Running   true    97d
acme-staging      ferriskey   1.4.2     Running   true    97d
legacy-sso        keycloak    26.0.7    Upgrading false   41d</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
