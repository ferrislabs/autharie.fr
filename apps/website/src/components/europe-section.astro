---
import Icon from './icon.astro'
import type { Locale } from '../i18n'

interface Props {
  locale?: Locale
  /** Hide the link to the dedicated page when already on it. */
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    eyebrow: 'Made in France',
    title: '100% European, from the code to the contract',
    lead: 'Who runs your sign in matters as much as how. Autharie is a French company with French governance, built and hosted in Europe, under European law.',
    badges: ['French company', 'Hosted at Scaleway', 'GDPR', 'Open source'],
    items: [
      {
        icon: 'globe',
        title: 'French governance',
        description:
          'A French company, decisions taken in France, contracts under French law. You know who you are dealing with and where to find them.',
      },
      {
        icon: 'server',
        title: 'Hosted in Europe',
        description:
          'On our clusters, your instance runs at Scaleway, a European cloud provider. Nothing about the service depends on infrastructure outside Europe.',
      },
      {
        icon: 'lock',
        title: 'Your data, your rules',
        description:
          'Need it inside your own perimeter? Run on a cluster you own: accounts, sessions and the database stay with you.',
      },
      {
        icon: 'branch',
        title: 'Open and reversible',
        description:
          'An open source IAM and plain Postgres. Sovereignty also means being able to leave, and taking everything with you.',
      },
    ],
  },
  fr: {
    eyebrow: 'Made in France',
    title: '100 % européen, du code au contrat',
    lead: 'Qui exploite votre connexion compte autant que la manière dont elle l’est. Autharie est une société française, à la gouvernance française, conçue et hébergée en Europe, sous droit européen.',
    badges: ['Société française', 'Hébergé chez Scaleway', 'RGPD', 'Open source'],
    items: [
      {
        icon: 'globe',
        title: 'Une gouvernance française',
        description:
          'Une société française, des décisions prises en France, des contrats de droit français. Vous savez à qui vous avez affaire et où nous trouver.',
      },
      {
        icon: 'server',
        title: 'Hébergé en Europe',
        description:
          'Sur nos clusters, votre instance tourne chez Scaleway, un fournisseur cloud européen. Rien dans le service ne dépend d’une infrastructure située hors d’Europe.',
      },
      {
        icon: 'lock',
        title: 'Vos données, vos règles',
        description:
          'Besoin qu’elles restent dans votre périmètre ? Faites tourner Autharie sur un cluster à vous : comptes, sessions et base restent chez vous.',
      },
      {
        icon: 'branch',
        title: 'Ouvert et réversible',
        description:
          'Un IAM open source et du Postgres ordinaire. La souveraineté, c’est aussi pouvoir partir, et emporter tout ce qui vous appartient.',
      },
    ],
  },
}
const t = copy[locale]
---

<section id="europe" class="relative scroll-mt-20 overflow-hidden bg-deep text-white">
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-[#0055A4] via-white to-[#EF4135]"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute -right-40 -top-40 size-[520px] rounded-full bg-primary/25 blur-[140px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <div class="max-w-2xl">
      <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.14em] text-primary-soft">
        <span class="inline-flex h-3 w-[18px] overflow-hidden rounded-[2px] ring-1 ring-white/30" aria-hidden="true">
          <i class="w-1/3 bg-[#0055A4]"></i>
          <i class="w-1/3 bg-white"></i>
          <i class="w-1/3 bg-[#EF4135]"></i>
        </span>
        {t.eyebrow}
      </p>
      <h2 class="mt-4 text-3xl text-white sm:text-[2.6rem] sm:leading-[1.1]">{t.title}</h2>
      <p class="mt-5 text-lg text-white/70">{t.lead}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          t.badges.map((badge) => (
            <li class="rounded-full border border-white/20 bg-white/5 px-3 py-1 text-xs font-medium text-white/80">
              {badge}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-xl bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.items.map((item) => (
          <div class="bg-deep p-7">
            <span class="flex size-9 items-center justify-center rounded-lg border border-white/15 bg-white/5 text-primary-soft">
              <Icon name={item.icon} class="size-[18px]" />
            </span>
            <h3 class="mt-4 font-semibold text-white">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
