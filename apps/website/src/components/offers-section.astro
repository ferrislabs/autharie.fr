---
import Icon from './icon.astro'
import { primaryCta } from '../platform'
import { localePath, type Locale } from '../i18n'
import { TCO_DEFAULTS, internalMonthly, priceOf } from '../pricing/model'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props
const consoleUrl = import.meta.env.PUBLIC_CONSOLE_URL || 'https://console.autharie.fr'
const cta = primaryCta(locale, consoleUrl)

// The example is the pricing page's own: the same model, the same defaults.
const business = priceOf({ mode: 'managed', engine: 'ferriskey', plan: 'business', volume: 10000 })
const autharieMonthly = business.kind === 'price' ? business.amount : 0
const internal = internalMonthly(TCO_DEFAULTS)
const yearlySaving = Math.round(((internal - autharieMonthly) * 12) / 100) * 100

const eur = new Intl.NumberFormat(locale === 'fr' ? 'fr-FR' : 'en-GB', {
  style: 'currency',
  currency: 'EUR',
  maximumFractionDigits: 0,
})

const copy = {
  en: {
    eyebrow: 'Pricing',
    title: 'Clear pricing, whichever way you deploy',
    intro:
      'Fully managed or in your own cloud, FerrisKey or Keycloak. FerrisKey is free up to 1,000 accounts, and the price updates as you choose.',
    primary: 'See the pricing',
    cardEyebrow: 'Comparison',
    cardTitle: 'What does it cost you to run it yourself?',
    cardLead: 'Set your own numbers and compare with the configuration you pick.',
    exampleLabel: 'Example: 75,000 € salary, 15% of a full-time position, high availability, 24/7 on-call',
    internal: 'In house',
    autharie: 'Autharie Business, 10,000 accounts',
    perMonth: 'per month',
    saving: 'about',
    perYear: 'a year',
    cta: 'Compare with your numbers',
  },
  fr: {
    eyebrow: 'Tarifs',
    title: 'Des tarifs lisibles, quel que soit votre mode de déploiement',
    intro:
      'Entièrement managé ou dans votre cloud, FerrisKey ou Keycloak. FerrisKey est gratuit jusqu’à 1 000 comptes, et le prix se recalcule selon vos choix.',
    primary: 'Voir les tarifs',
    cardEyebrow: 'Comparateur',
    cardTitle: 'Combien vous coûte de l’exploiter vous-même ?',
    cardLead: 'Saisissez vos propres chiffres et comparez avec la configuration choisie.',
    exampleLabel: 'Exemple : 75 000 € de salaire, 15 % d’un temps plein, haute disponibilité, astreinte 24/7',
    internal: 'En interne',
    autharie: 'Autharie Business, 10 000 comptes',
    perMonth: 'par mois',
    saving: 'environ',
    perYear: 'par an',
    cta: 'Comparer avec mes chiffres',
  },
}
const t = copy[locale]
---

<section id="offers" class="scroll-mt-20 border-y bg-surface/50">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-20 sm:py-28 lg:grid-cols-2 lg:gap-16">
    <div>
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 class="mt-4 text-3xl sm:text-[2.6rem] sm:leading-[1.1]">{t.title}</h2>
      <p class="mt-5 text-lg text-muted-foreground">{t.intro}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={localePath(locale, '/pricing')}
          class="inline-flex h-11 items-center gap-2 rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          <span>{t.primary}</span>
          <Icon name="arrow" class="size-4" />
        </a>
        <a
          href={cta.href}
          class="inline-flex h-11 items-center rounded-md border bg-card px-6 text-sm font-medium transition-colors hover:bg-accent"
        >
          {cta.label}
        </a>
      </div>
    </div>

    <a
      href={localePath(locale, '/pricing#compare')}
      class="group block rounded-2xl border border-primary/30 bg-card p-6 shadow-[0_24px_48px_-28px_rgb(60_40_160/0.35)] transition-all hover:-translate-y-0.5 hover:border-primary/50 sm:p-8"
    >
      <p class="eyebrow">{t.cardEyebrow}</p>
      <h3 class="mt-3 text-xl font-semibold leading-snug sm:text-2xl">{t.cardTitle}</h3>
      <p class="mt-2 text-sm text-muted-foreground">{t.cardLead}</p>

      <div class="mt-6 rounded-xl bg-surface p-4 sm:p-5" aria-hidden="true">
        <p class="text-xs text-muted-foreground">{t.exampleLabel}</p>
        <div class="mt-4 grid grid-cols-2 gap-4">
          <div>
            <p class="text-xs text-muted-foreground">{t.internal}</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums">{eur.format(internal)}</p>
            <p class="text-xs text-muted-foreground">{t.perMonth}</p>
          </div>
          <div>
            <p class="text-xs text-muted-foreground">{t.autharie}</p>
            <p class="mt-1 text-2xl font-semibold tracking-tight tabular-nums">{eur.format(autharieMonthly)}</p>
            <p class="text-xs text-muted-foreground">{t.perMonth}</p>
          </div>
        </div>
        <p class="mt-4 border-t pt-3 text-sm">
          <span class="text-muted-foreground">{t.saving}</span>
          <span class="font-semibold text-emerald-600">{eur.format(yearlySaving)}</span>
          <span class="text-muted-foreground">{t.perYear}</span>
        </p>
      </div>

      <span class="mt-6 inline-flex h-11 items-center gap-2 rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors group-hover:bg-primary/90">
        {t.cta}
        <Icon name="arrow" class="size-4" />
      </span>
    </a>
  </div>
</section>
