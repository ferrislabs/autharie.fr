---
import type { Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    title: 'Users, services, agents: three identities, often three patch jobs',
    lead: 'Sign in built by hand for your users, API keys lying around for your services, and now AI agents acting on their own. Each one ends up with its own rules, and nobody sees the whole picture.',
    items: [
      {
        title: 'Your users',
        description: 'Two-factor, passkeys, company SSO: weeks of work before the first customer, then security fixes to keep up with.',
      },
      {
        title: 'Your services',
        description: 'Shared API keys, never rotated, that open far more than the service needs.',
      },
      {
        title: 'Your AI agents',
        description: 'Rights that are too broad, no record of who started them, and no stop button when they run away.',
      },
    ],
  },
  fr: {
    title: 'Utilisateurs, services, agents : trois identités, souvent trois bricolages',
    lead: 'Une connexion codée à la main pour vos utilisateurs, des clés API qui traînent pour vos services, et maintenant des agents IA qui agissent seuls. Chacun finit avec ses propres règles, et personne n’a la vue d’ensemble.',
    items: [
      {
        title: 'Vos utilisateurs',
        description: 'Double authentification, passkeys, SSO d’entreprise : des semaines de travail avant le premier client, puis des correctifs de sécurité à suivre.',
      },
      {
        title: 'Vos services',
        description: 'Des clés API partagées, jamais renouvelées, qui ouvrent bien plus que ce dont le service a besoin.',
      },
      {
        title: 'Vos agents IA',
        description: 'Des droits trop larges, aucune trace de qui les a lancés, et pas de bouton stop quand ils s’emballent.',
      },
    ],
  },
}
const t = copy[locale]
---

<section id="problem" class="scroll-mt-20 border-y bg-surface/50">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="max-w-3xl">
      <h2 class="text-balance text-3xl sm:text-[2.6rem] sm:leading-[1.1]">{t.title}</h2>
      <p class="mt-5 text-lg text-muted-foreground">{t.lead}</p>
    </div>
    <ul class="mt-12 grid gap-8 sm:grid-cols-3 sm:gap-10">
      {
        t.items.map((item) => (
          <li class="border-t-2 border-ink pt-5">
            <h3 class="font-semibold">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
