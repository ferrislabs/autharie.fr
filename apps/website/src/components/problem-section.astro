---
import type { Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    title: 'Your agents move faster than your access rules',
    lead: 'AI is everywhere now: assistants, automations, in-house agents. Identity and access were designed for people who click, not for software that acts on its own.',
    items: [
      {
        title: 'Agents with far too many rights',
        description: 'To move fast, they get an admin API key. One mistake, and the agent can do anything.',
      },
      {
        title: 'No idea what happened',
        description: 'When an agent acts, nobody knows who started it, on whose behalf, or with which right.',
      },
      {
        title: 'No stop button',
        description: 'An agent that runs away keeps going until someone notices the damage.',
      }
    ],
  },
  fr: {
    title: 'Vos agents vont plus vite que vos règles d’accès',
    lead: 'L’IA entre partout : assistants, automatisations, agents maison. Mais l’identité et les accès ont été pensés pour des humains qui cliquent, pas pour des logiciels qui agissent seuls.',
    items: [
      {
        title: 'Des agents avec beaucoup trop de droits',
        description: 'Pour aller vite, on leur donne une clé API admin. Une erreur, et l’agent peut tout faire.',
      },
      {
        title: 'Aucune idée de ce qui s’est passé',
        description: 'Quand un agent agit, personne ne sait qui l’a lancé, au nom de qui, ni avec quel droit.',
      },
      {
        title: 'Pas de bouton stop',
        description: 'Un agent qui s’emballe continue jusqu’à ce que quelqu’un remarque les dégâts.',
      }
    ],
  },
}
const t = copy[locale]
---

<section id="problem" class="scroll-mt-20 border-y bg-surface/50">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
    <div class="max-w-3xl">
      <h2 class="text-balance text-3xl sm:text-[2.6rem] sm:leading-[1.1]">{t.title}</h2>
      <p class="mt-5 text-lg text-muted-foreground">{t.lead}</p>
    </div>
    <ul class="mt-12 grid gap-8 sm:grid-cols-3 sm:gap-10">
      {
        t.items.map((item) => (
          <li class="border-t-2 border-ink pt-5">
            <h3 class="font-semibold">{item.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
