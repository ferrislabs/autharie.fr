---
import Icon from './icon.astro'
import { type Locale } from '../i18n'
import { Button, ConsoleWindow, Field, Icon as ConsoleIcon, Input, NavTabs, Page, PageTitle, Section, TopBar } from './console/ui'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    items: [
      {
        icon: 'plug',
        title: 'Ferriskey or Keycloak',
        description:
          'Both run on the same platform, with the same operations wrapped around them. Pick the one your applications already speak to.',
      },
      {
        icon: 'database',
        title: 'A Postgres cluster comes with it',
        description:
          'Provisioned next to the instance, archived on a schedule, and restorable from the console. You never open a database console to get started.',
      },
      {
        icon: 'lock',
        title: 'TLS on the first boot',
        description:
          'A certificate is issued for the hostname you chose and renewed before it lapses. There is no step where you copy a PEM file around.',
      },
      {
        icon: 'cpu',
        title: 'A size that fits your traffic',
        description:
          'Start small to try things against, pick a larger size for real sign in traffic, and move to a cluster of your own when you need nothing else scheduled beside you.',
      },
    ],
    offers: [
      { name: 'Sandbox', detail: '1 000 users' },
      { name: 'Standard', detail: '10 000 users', selected: true },
      { name: 'Pro', detail: '50 000 users' },
      { name: 'Scale', detail: '150 000 users · dedicated' },
    ],
    eyebrow: 'Deploy',
    heading: 'From nothing to a working issuer in a few minutes',
    intro:
      'Choose a provider, a version and a hostname. Everything the instance needs in order to answer its first token request is created with it.',
    newDeployment: 'New deployment',
    crumb: 'Deployments',
    tabs: ['Overview', 'Deployments', 'Members', 'Roles'],
    provider: 'Identity provider',
    version: 'Version',
    versionNote: 'The newest available version, chosen for you.',
    details: 'Details',
    name: 'Name',
    environment: 'Environment',
    environmentValue: 'Production',
    hostname: 'Hostname',
    size: 'Offer',
    cancel: 'Cancel',
    create: 'Create deployment',
    included: 'Postgres, TLS and daily archives are included',
  },
  fr: {
    items: [
      {
        icon: 'plug',
        title: 'Ferriskey ou Keycloak',
        description:
          'Les deux tournent sur la même plateforme, avec les mêmes opérations autour. Choisissez celui avec lequel vos applications parlent déjà.',
      },
      {
        icon: 'database',
        title: 'Un cluster Postgres est fourni',
        description:
          "Il est provisionné à côté de l'instance, archivé selon un calendrier et restaurable depuis la console. Vous n'ouvrez jamais de console de base de données pour démarrer.",
      },
      {
        icon: 'lock',
        title: 'TLS dès le premier démarrage',
        description:
          "Un certificat est émis pour le nom d'hôte choisi et renouvelé avant son expiration. Il n'y a aucune étape où l'on copie un fichier PEM à la main.",
      },
      {
        icon: 'cpu',
        title: 'Une taille adaptée à votre trafic',
        description:
          "Commencez petit pour essayer, choisissez une taille supérieure pour du trafic de connexion réel, et passez sur un cluster à vous quand vous ne voulez rien d'autre planifié à côté.",
      },
    ],
    offers: [
      { name: 'Sandbox', detail: '1 000 utilisateurs' },
      { name: 'Standard', detail: '10 000 utilisateurs', selected: true },
      { name: 'Pro', detail: '50 000 utilisateurs' },
      { name: 'Scale', detail: '150 000 utilisateurs · dédié' },
    ],
    eyebrow: 'Déploiement',
    heading: "D'un projet vide à un émetteur opérationnel en quelques minutes",
    intro:
      "Choisissez un fournisseur, une version et un nom d'hôte. Tout ce dont l'instance a besoin pour répondre à sa première demande de jeton est créé avec elle.",
    newDeployment: 'Nouveau déploiement',
    crumb: 'Déploiements',
    tabs: ['Vue d\'ensemble', 'Déploiements', 'Membres', 'Rôles'],
    provider: "Fournisseur d'identité",
    version: 'Version',
    versionNote: 'La version la plus récente disponible, choisie pour vous.',
    details: 'Détails',
    name: 'Nom',
    environment: 'Environnement',
    environmentValue: 'Production',
    hostname: "Nom d'hôte",
    size: 'Offre',
    cancel: 'Annuler',
    create: 'Créer le déploiement',
    included: 'Postgres, TLS et archives quotidiennes inclus',
  },
}

const t = copy[locale]
const items = t.items
const offers = t.offers
---

<section id="platform" class="scroll-mt-20 overflow-hidden">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <div class="grid gap-14 lg:grid-cols-2 lg:items-center lg:gap-20">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 class="mt-4 text-3xl sm:text-[2.6rem] sm:leading-[1.1]">
          {t.heading}
        </h2>
        <p class="mt-5 text-lg text-muted-foreground">
          {t.intro}
        </p>

        <div class="mt-10 space-y-7">
          {
            items.map((item) => (
              <div class="flex gap-4">
                <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-lg border bg-card text-primary">
                  <Icon name={item.icon} class="size-[18px]" />
                </span>
                <div>
                  <h3 class="font-semibold">
                    {item.title}
                  </h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                    {item.description}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- visual -->
      <div class="relative">
        <div
          class="pointer-events-none absolute -inset-6 -z-10 rounded-3xl bg-primary/5"
          aria-hidden="true"
        >
        </div>
        <div aria-hidden="true" class="min-w-0">
          <ConsoleWindow className="shadow-sm">
            <TopBar crumbs={[{ label: t.crumb, icon: 'boxes' }, { label: t.newDeployment }]} />
            <NavTabs
              tabs={[
                { label: t.tabs[0], icon: 'layout-grid' },
                { label: t.tabs[1], icon: 'boxes', active: true },
                { label: t.tabs[2], icon: 'users' },
                { label: t.tabs[3], icon: 'shield-check' },
              ]}
            />
            <Page>
              <PageTitle title={t.newDeployment} />
              <div class="mt-6 space-y-6">
                <Section title={t.provider}>
                  <div class="grid gap-3 sm:grid-cols-2">
                    <div class="relative flex flex-col rounded-lg border border-primary bg-primary/5 p-4">
                      <ConsoleIcon name="check" className="absolute right-3 top-3 h-4 w-4 text-primary" />
                      <span class="pr-6 text-sm font-medium">Ferriskey</span>
                    </div>
                    <div class="flex flex-col rounded-lg border p-4">
                      <span class="text-sm font-medium">Keycloak</span>
                    </div>
                  </div>
                  <div class="mt-3 space-y-1.5">
                    <p class="text-sm font-medium leading-none">{t.version}</p>
                    <p class="font-mono text-sm">1.4.2</p>
                    <p class="text-xs text-muted-foreground">{t.versionNote}</p>
                  </div>
                </Section>

                <Section title={t.details}>
                  <div class="grid gap-4 sm:grid-cols-2">
                    <Field label={t.name}><Input value="auth" /></Field>
                    <Field label={t.environment}>
                      <div class="flex h-9 w-full items-center justify-between rounded-md border bg-transparent px-3 text-sm shadow-xs">
                        {t.environmentValue}
                        <ConsoleIcon name="chevron-down" className="h-4 w-4 opacity-50" />
                      </div>
                    </Field>
                    <div class="sm:col-span-2">
                      <Field label={t.hostname}><Input value="id.acme.com" className="font-mono" /></Field>
                    </div>
                  </div>
                </Section>

                <Section title={t.size}>
                  <div class="grid grid-cols-2 gap-3">
                    {
                      offers.map((offer) => (
                        <div
                          class:list={[
                            'relative flex flex-col gap-1 rounded-lg border p-4',
                            offer.selected ? 'border-primary bg-primary/5' : 'border-border',
                          ]}
                        >
                          {offer.selected && (
                            <ConsoleIcon name="check" className="absolute right-3 top-3 h-4 w-4 text-primary" />
                          )}
                          <span class="pr-6 text-sm font-medium">{offer.name}</span>
                          <span class="font-mono text-xs text-muted-foreground">{offer.detail}</span>
                        </div>
                      ))
                    }
                  </div>
                </Section>

                <p class="flex items-center gap-2 text-xs text-muted-foreground">
                  <ConsoleIcon name="check" className="h-4 w-4 text-primary" />
                  {t.included}
                </p>

                <div class="flex items-center justify-end gap-2 border-t pt-4">
                  <Button variant="ghost">{t.cancel}</Button>
                  <Button>{t.create}</Button>
                </div>
              </div>
            </Page>
          </ConsoleWindow>
        </div>
      </div>
    </div>
  </div>
</section>
