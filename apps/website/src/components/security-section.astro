---
import Icon from './icon.astro'
import ComplianceBadge from './compliance-badge.astro'
import { localePath, type Locale } from '../i18n'

interface Props {
  locale?: Locale
}

const { locale = 'en' } = Astro.props

const copy = {
  en: {
    items: [
      {
        icon: 'key',
        title: 'Keys wrapped, never stored bare',
        description:
          'Each archive gets its own data key, wrapped by a key held in OpenBao or Vault and kept only in wrapped form. Rotating adds a version instead of replacing one, so archives taken last year still open.',
      },
      {
        icon: 'network',
        title: 'You decide who may reach it',
        description:
          'An allow list of source ranges sits in front of each deployment and changes without a redeploy. Clearing it puts the instance back on the open network, and the console says so.',
      },
      {
        icon: 'users',
        title: 'Roles granted where they apply',
        description:
          'Permissions are given per organisation and per deployment, from read only to full control. Invitations lapse on their own rather than sitting open forever.',
      },
      {
        icon: 'scroll',
        title: 'An audit log you can hand over',
        description:
          'Every action carries who did it and when. It is written for the person who has to answer a question about it months later.',
      },
    ],
    eyebrow: 'Security',
    heading: 'Built to be answerable',
    intro:
      'An identity provider is the thing an auditor asks about first. These are the answers.',
    notYet: 'Your data, your perimeter',
    notYetText:
      'Archives are encrypted at rest. To keep full control of where the data lives, run Autharie on a cluster you own: accounts, sessions and the database stay in your infrastructure, and the platform only sends instructions.',
    link: 'Read the security documentation',
    compliant: 'Compliant',
    gdprName: 'GDPR',
  },
  fr: {
    items: [
      {
        icon: 'key',
        title: 'Des clés enveloppées, jamais stockées en clair',
        description:
          "Chaque archive a sa propre clé de données, enveloppée par une clé détenue dans OpenBao ou Vault et conservée uniquement sous forme enveloppée. Une rotation ajoute une version au lieu d'en remplacer une, donc les archives de l'an dernier restent lisibles.",
      },
      {
        icon: 'network',
        title: 'Vous décidez qui peut y accéder',
        description:
          "Une liste d'autorisation de plages sources se place devant chaque déploiement et se modifie sans redéploiement. La vider remet l'instance sur le réseau ouvert, et la console le signale.",
      },
      {
        icon: 'users',
        title: 'Des rôles accordés là où ils s\'appliquent',
        description:
          "Les permissions sont données par organisation et par déploiement, de la lecture seule au contrôle total. Les invitations expirent d'elles-mêmes au lieu de rester ouvertes indéfiniment.",
      },
      {
        icon: 'scroll',
        title: "Un journal d'audit que vous pouvez transmettre",
        description:
          "Chaque action indique qui l'a faite et quand. Il est écrit pour la personne qui devra répondre à une question à ce sujet des mois plus tard.",
      },
    ],
    eyebrow: 'Sécurité',
    heading: 'Conçu pour rendre des comptes',
    intro:
      "Un fournisseur d'identité est la première chose dont un auditeur s'enquiert. Voici les réponses.",
    notYet: "Vos données, votre périmètre",
    notYetText:
      "Les archives sont chiffrées au repos. Pour garder la maîtrise totale de l'endroit où vivent les données, faites tourner Autharie sur un cluster qui vous appartient : les comptes, les sessions et la base restent dans votre infrastructure, et la plateforme se contente d'envoyer des instructions.",
    link: 'Lire la documentation sécurité',
    compliant: 'Conforme',
    gdprName: 'RGPD',
  },
}

const t = copy[locale]
const badges = [
  { kind: 'iso', name: 'ISO 27001' },
  { kind: 'soc2', name: 'SOC 2' },
  { kind: 'nis2', name: 'NIS 2' },
  { kind: 'gdpr', name: t.gdprName },
  { kind: 'hds', name: 'HDS' },
  { kind: 'secnumcloud', name: 'SecNumCloud' },
] as const
const items = t.items
---

<section id="security" class="scroll-mt-20 bg-deep text-white">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:py-28">
    <div class="max-w-2xl">
      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-primary-soft">
        {t.eyebrow}
      </p>
      <h2 class="mt-4 text-3xl text-white sm:text-[2.6rem] sm:leading-[1.1]">
        {t.heading}
      </h2>
      <p class="mt-5 text-lg text-white/70">
        {t.intro}
      </p>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-xl bg-white/10 sm:grid-cols-2">
      {
        items.map((item) => (
          <div class="bg-deep p-7">
            <span class="flex size-9 items-center justify-center rounded-lg border border-white/15 bg-white/5 text-primary-soft">
              <Icon name={item.icon} class="size-[18px]" />
            </span>
            <h3 class="mt-4 font-semibold text-white">
              {item.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-white/60">
              {item.description}
            </p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 grid gap-10 rounded-xl border border-white/15 bg-white/5 p-7 lg:grid-cols-[1fr_auto] lg:gap-14">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-white/50">
          {t.notYet}
        </p>
        <p class="mt-3 max-w-xl text-white/80">
          {t.notYetText}
        </p>
        <a
          href={localePath(locale, '/docs')}
          class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-primary-soft transition-opacity hover:opacity-80"
        >
          <span>{t.link}</span>
          <Icon name="arrow" class="size-4" />
        </a>
      </div>

      <ul class="grid grid-cols-2 gap-x-10 gap-y-7 border-white/15 sm:grid-cols-3 lg:border-l lg:pl-14">
        {
          badges.map((badge) => (
            <li class="flex flex-col items-center text-center">
              <ComplianceBadge kind={badge.kind} class="size-14 text-primary-soft" />
              <p class="mt-3 text-sm font-medium text-white">{badge.name}</p>
              <p class="mt-0.5 text-xs text-white/50">{t.compliant}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
