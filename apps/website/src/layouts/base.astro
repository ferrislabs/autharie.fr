---
import '../styles/globals.css'
import { ClientRouter } from 'astro:transitions'
import { formatTitle } from '@explainer/config'
import { siteConfig } from '../config'
import { localeFromUrl, locales, switchPath } from '../i18n'

interface Props {
  title: string
  description?: string
  /** Path or URL of the social card. Defaults to the one generated for this page. */
  thumbnail?: string
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean
}

const { title, description, thumbnail, noindex = false } = Astro.props
const locale = localeFromUrl(Astro.url)
const site = Astro.site ?? new URL('https://autharie.fr')
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const canonical = new URL(pathname, site).href
const thumbnailUrl = new URL(thumbnail ?? `${pathname}thumbnail.png`, site).href
const metaDescription = description ?? siteConfig.description
const ogLocale = { en: 'en_GB', fr: 'fr_FR' }[locale]
const ogLocaleAlternate = locale === 'en' ? 'fr_FR' : 'en_GB'
const alt = (l: (typeof locales)[number]) => new URL(switchPath(pathname, l), site).href

// Umami, only when an instance is configured. Not tracked on localhost or previews.
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC
const umamiId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Autharie',
    url: site.href,
    logo: new URL('/logo.svg', site).href,
    sameAs: ['https://github.com/ferriskey'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Autharie',
    url: site.href,
    inLanguage: locale,
  },
]
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href={siteConfig.favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=JetBrains+Mono:wght@400;500;600&family=Noto+Sans:wght@400;500;600;700&display=swap"
    />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
    <link rel="alternate" hreflang="x-default" href={alt('en')} />
    <meta name="theme-color" content="#fdfdfe" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="description" content={metaDescription} />
    <meta property="og:site_name" content="Autharie" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={thumbnailUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={siteConfig.ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={thumbnailUrl} />
    <meta name="twitter:image:alt" content={title} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    {
      umamiSrc && umamiId && (
        <script
          is:inline
          defer
          src={umamiSrc}
          data-website-id={umamiId}
          data-domains={site.hostname}
          data-do-not-track="true"
        />
      )
    }
    <title>{formatTitle(siteConfig, title)}</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <slot />
  </body>
</html>
